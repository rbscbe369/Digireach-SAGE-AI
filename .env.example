# Digireach SAGE AI — Environment Variables Reference
# Copy this file to .env.local for local development

# ==========================================
# DATABASE
# ==========================================
DATABASE_URL="postgresql://user:password@localhost:5432/sageai"

# ==========================================
# AUTHENTICATION (NextAuth v5)
# ==========================================
AUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Google OAuth (optional)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub OAuth (optional)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ==========================================
# REDIS (BullMQ Background Workers)
# ==========================================
REDIS_URL="redis://localhost:6379"

# ==========================================
# AI PROVIDERS
# ==========================================
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""
GROQ_API_KEY=""
MISTRAL_API_KEY=""

# ==========================================
# VECTOR DATABASE
# ==========================================
PINECONE_API_KEY=""
PINECONE_ENVIRONMENT=""
PINECONE_INDEX_NAME="sageai-knowledge"

# ==========================================
# FILE STORAGE
# ==========================================
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"
AWS_S3_BUCKET=""

# ==========================================
# EMAIL
# ==========================================
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
FROM_EMAIL="noreply@digireach.ai"

# ==========================================
# PAYMENTS
# ==========================================
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# ==========================================
# OBSERVABILITY
# ==========================================
SENTRY_DSN=""
POSTHOG_API_KEY=""
POSTHOG_HOST="https://app.posthog.com"

# ==========================================
# APPLICATION
# ==========================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Digireach SAGE AI"
NODE_ENV="development"
