  project AiSearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("ai_search_knowledge_reports")
}

model AiSearchCitationReport {
  id                 String   @id @default(uuid())
  projectId          String   @map("project_id")
  citationDiversity  Float    @default(0.0) @map("citation_diversity")
  primarySources     Int      @default(0) @map("primary_sources")
  brokenCitations    Int      @default(0) @map("broken_citations")
