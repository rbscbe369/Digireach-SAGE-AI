  machineReadability  Float    @default(0.0) @map("machine_readability")
  analysisData        Json     @map("analysis_data")
  createdAt           DateTime @default(now()) @map("created_at")

  project AiSearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("ai_search_geo_reports")
}

model AiSearchEntityReport {
  id              String   @id @default(uuid())
  projectId       String   @map("project_id")
  entityDensity   Float    @default(0.0) @map("entity_density")
  missingEntities Json     @map("missing_entities") // Array of suggested entities
  orphanEntities  Json     @map("orphan_entities")
  createdAt       DateTime @default(now()) @map("created_at")

  project AiSearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("ai_search_entity_reports")
}

model AiSearchSemanticReport {
  id                 String   @id @default(uuid())
  projectId          String   @map("project_id")
  semanticSimilarity Float    @default(0.0) @map("semantic_similarity")
  topicAuthority     Float    @default(0.0) @map("topic_authority")
  intentSatisfaction Float    @default(0.0) @map("intent_satisfaction")
  analysisData       Json     @map("analysis_data")
