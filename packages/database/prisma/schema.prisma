  priority     String   @default("MEDIUM") // HIGH, MEDIUM, LOW
  status       String   @default("PENDING") // PENDING, APPLIED, DISMISSED
  createdAt    DateTime @default(now()) @map("created_at")

  project AiSearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, category])
  @@map("ai_search_recommendations")
}

model AiSearchVisibilityHistory {
  id              String   @id @default(uuid())
  projectId       String   @map("project_id")
  snapshotDate    DateTime @map("snapshot_date")
  visibilityScore Float    @map("visibility_score")
  metricsSnapshot Json     @map("metrics_snapshot")
  createdAt       DateTime @default(now()) @map("created_at")

  project AiSearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, snapshotDate])
  @@map("ai_search_visibility_history")
}

// =========================================================
// 25. ENTERPRISE AI WORKFLOW AUTOMATION & VISUAL AUTOMATION BUILDER (MODULE 025)
// =========================================================

model AutomationWorkflow {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  description    String?  @db.Text
  status         String   @default("DRAFT") // DRAFT, ACTIVE, PAUSED, ARCHIVED
  version        Int      @default(1)
  settings       Json? // Timeout, retry policy, error handling
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  nodes        AutomationNode[]
  edges        AutomationEdge[]
  variables    AutomationVariable[]
  executions   AutomationExecution[]
  schedules    AutomationSchedule[]
  webhooks     AutomationWebhook[]
  history      AutomationHistory[]

  @@index([organizationId])
  @@map("automation_workflows")
}

model AutomationNode {
  id         String   @id @default(uuid())
  workflowId String   @map("workflow_id")
  type       String // TRIGGER, ACTION, LOGIC, UTILITY
  subType    String   @map("sub_type") // WEBHOOK, RUN_RESEARCH, IF_ELSE
  label      String
  positionX  Float    @map("position_x")
  positionY  Float    @map("position_y")
  config     Json // Node specific configuration (e.g., prompt, target URL)
  createdAt  DateTime @default(now()) @map("created_at")

  workflow    AutomationWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  sourceEdges AutomationEdge[]   @relation("SourceEdges")
  targetEdges AutomationEdge[]   @relation("TargetEdges")

  @@index([workflowId])
  @@map("automation_nodes")
}

model AutomationEdge {
  id           String   @id @default(uuid())
  workflowId   String   @map("workflow_id")
  sourceNodeId String   @map("source_node_id")
  targetNodeId String   @map("target_node_id")
  sourceHandle String?  @map("source_handle") // for multiple outputs (e.g., true/false)
  targetHandle String?  @map("target_handle")
  createdAt    DateTime @default(now()) @map("created_at")

  workflow   AutomationWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  sourceNode AutomationNode     @relation("SourceEdges", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode AutomationNode     @relation("TargetEdges", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@map("automation_edges")
}

model AutomationVariable {
  id             String   @id @default(uuid())
  workflowId     String?  @map("workflow_id") // Null means Global Workspace Variable
  organizationId String?  @map("organization_id")
  key            String
  value          String   @db.Text
  isSecret       Boolean  @default(false) @map("is_secret")
  createdAt      DateTime @default(now()) @map("created_at")

  workflow AutomationWorkflow? @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([organizationId])
  @@map("automation_variables")
}

model AutomationTemplate {
  id           String   @id @default(uuid())
  name         String
  description  String?  @db.Text
  category     String // MARKETING, SEO, SALES, HR
  workflowData Json     @map("workflow_data") // Serialized nodes and edges
  useCount     Int      @default(0) @map("use_count")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("automation_templates")
}

model AutomationExecution {
  id            String    @id @default(uuid())
  workflowId    String    @map("workflow_id")
  status        String    @default("PENDING") // RUNNING, COMPLETED, FAILED, PAUSED
  triggerType   String    @map("trigger_type") // MANUAL, WEBHOOK, SCHEDULE
  startedAt     DateTime? @map("started_at")
  completedAt   DateTime? @map("completed_at")
  durationMs    Int?      @map("duration_ms")
  aiCreditsUsed Float     @default(0.0) @map("ai_credits_used")
  createdAt     DateTime  @default(now()) @map("created_at")

  workflow  AutomationWorkflow   @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  logs      AutomationLog[]
  errors    AutomationError[]
  approvals AutomationApproval[]

  @@index([workflowId, status])
  @@map("automation_executions")
}

model AutomationLog {
  id          String   @id @default(uuid())
  executionId String   @map("execution_id")
  nodeId      String   @map("node_id")
  status      String // SUCCESS, FAILED
  inputData   Json?    @map("input_data")
  outputData  Json?    @map("output_data")
  durationMs  Int      @default(0) @map("duration_ms")
  createdAt   DateTime @default(now()) @map("created_at")

  execution AutomationExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@map("automation_logs")
}

model AutomationWebhook {
  id         String   @id @default(uuid())
  workflowId String   @map("workflow_id")
  path       String   @unique // Auto-generated UUID for the webhook URL
  method     String   @default("POST")
  authType   String   @default("NONE") // BASIC, BEARER, SIGNATURE
  secret     String?
  createdAt  DateTime @default(now()) @map("created_at")

  workflow AutomationWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@map("automation_webhooks")
}

model AutomationSchedule {
  id             String    @id @default(uuid())
  workflowId     String    @map("workflow_id")
  cronExpression String    @map("cron_expression")
  timezone       String    @default("UTC")
  isActive       Boolean   @default(true) @map("is_active")
  nextRunAt      DateTime? @map("next_run_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  workflow AutomationWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@map("automation_schedules")
}

model AutomationApproval {
  id          String    @id @default(uuid())
  executionId String    @map("execution_id")
  status      String    @default("PENDING") // APPROVED, REJECTED
  assignedTo  String    @map("assigned_to") // User ID
  message     String?   @db.Text
  resolvedAt  DateTime? @map("resolved_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  execution AutomationExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@map("automation_approvals")
}

model AutomationError {
  id           String   @id @default(uuid())
  executionId  String   @map("execution_id")
  nodeId       String?  @map("node_id")
  errorCode    String   @map("error_code")
  errorMessage String   @map("error_message") @db.Text
  stackTrace   String?  @map("stack_trace") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  execution AutomationExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@map("automation_errors")
}

model AutomationHistory {
  id         String   @id @default(uuid())
  workflowId String   @map("workflow_id")
  userId     String?  @map("user_id")
  action     String // CREATED, UPDATED, DELETED, ACTIVATED
  changes    Json? // Diff of changes
  createdAt  DateTime @default(now()) @map("created_at")

  workflow AutomationWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@map("automation_history")
}

