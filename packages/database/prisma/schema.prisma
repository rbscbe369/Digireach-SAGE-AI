  contacts CrmContact[]
  deals    CrmDeal[]

  @@index([organizationId])
  @@map("crm_companies")
}

model CrmPipeline {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  createdAt      DateTime @default(now()) @map("created_at")

  stages CrmPipelineStage[]
  deals  CrmDeal[]

  @@index([organizationId])
  @@map("crm_pipelines")
