model SeoProject {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  domain         String
  targetLocation String   @default("us") @map("target_location")
  targetLanguage String   @default("en") @map("target_language")
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  keywords     SeoKeyword[]
  competitors  SeoCompetitor[]
  audits       SeoTechnicalAudit[]
  reports      SeoProjectReport[]
  history      SeoHistory[]

  @@index([organizationId])
  @@map("seo_projects")
}

model SeoKeyword {
  id         String   @id @default(uuid())
  projectId  String   @map("project_id")
  keyword    String
  volume     Int      @default(0)
  difficulty Float    @default(0.0)
  cpc        Float    @default(0.0)
  intent     String // INFORMATIONAL, NAVIGATIONAL, COMMERCIAL, TRANSACTIONAL
  clusterId  String?  @map("cluster_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  project     SeoProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cluster     SeoKeywordCluster? @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  rankings    SeoRanking[]
  serpResults SeoSerpResult[]

  @@index([projectId, keyword])
  @@map("seo_keywords")
}

model SeoKeywordCluster {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  name      String
  topic     String
  createdAt DateTime @default(now()) @map("created_at")

  keywords SeoKeyword[]

  @@index([projectId])
  @@map("seo_keyword_clusters")
}

model SeoSerpResult {
  id               String   @id @default(uuid())
  keywordId        String   @map("keyword_id")
  rank             Int
  url              String
  title            String?
  description      String?  @db.Text
  domainAuthority  Float?   @map("domain_authority")
  estimatedTraffic Int?     @map("estimated_traffic")
  scrapedData      Json?    @map("scraped_data") // Headings, entities, schema
  createdAt        DateTime @default(now()) @map("created_at")

  keyword SeoKeyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@index([keywordId])
  @@map("seo_serp_results")
}

model SeoCompetitor {
  id               String   @id @default(uuid())
  projectId        String   @map("project_id")
  domain           String
  estimatedTraffic Int      @default(0) @map("estimated_traffic")
  domainAuthority  Float    @default(0.0) @map("domain_authority")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  project     SeoProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contentGaps SeoContentGap[]

  @@index([projectId])
  @@map("seo_competitors")
}

model SeoContentGap {
  id             String   @id @default(uuid())
  competitorId   String   @map("competitor_id")
  missingKeyword String   @map("missing_keyword")
  volume         Int      @default(0)
  difficulty     Float    @default(0.0)
  createdAt      DateTime @default(now()) @map("created_at")

  competitor SeoCompetitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@index([competitorId])
  @@map("seo_content_gaps")
}

model SeoEntity {
  id               String   @id @default(uuid())
  projectId        String   @map("project_id")
  name             String
  entityType       String   @map("entity_type") // PERSON, ORGANIZATION, PRODUCT
  knowledgeGraphId String?  @map("knowledge_graph_id") // Links to Module 009
  salience         Float    @default(0.0)
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([projectId])
  @@map("seo_entities")
}

model SeoInternalLink {
  id         String   @id @default(uuid())
  projectId  String   @map("project_id")
  sourceUrl  String   @map("source_url")
  targetUrl  String   @map("target_url")
  anchorText String   @map("anchor_text")
  status     String   @default("ACTIVE") // ACTIVE, BROKEN, NOFOLLOW
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([projectId])
  @@map("seo_internal_links")
}

model SeoBacklink {
  id              String   @id @default(uuid())
  projectId       String   @map("project_id")
  url             String
  domain          String
  domainAuthority Float    @default(0.0) @map("domain_authority")
  anchorText      String   @map("anchor_text")
  isDofollow      Boolean  @default(true) @map("is_dofollow")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([projectId])
  @@map("seo_backlinks")
}

model SeoSchema {
  id         String   @id @default(uuid())
  projectId  String   @map("project_id")
  url        String
  schemaType String   @map("schema_type") // Article, FAQPage, Organization
  schemaData Json     @map("schema_data")
  isValid    Boolean  @default(true) @map("is_valid")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([projectId])
  @@map("seo_schema")
}

model SeoTechnicalAudit {
  id          String    @id @default(uuid())
  projectId   String    @map("project_id")
  url         String
  score       Float     @default(0.0)
  issues      Json // Array of technical issues (404s, slow LCP, etc.)
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  project SeoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("seo_technical_audits")
}

model SeoProjectReport {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  name        String
  reportType  String   @map("report_type") // AUDIT, KEYWORDS, COMPETITORS
  downloadUrl String?  @map("download_url")
  createdAt   DateTime @default(now()) @map("created_at")

  project SeoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("seo_project_reports")
}

model SeoRanking {
  id        String   @id @default(uuid())
  keywordId String   @map("keyword_id")
  rank      Int
  url       String?
  trackedAt DateTime @map("tracked_at")
  createdAt DateTime @default(now()) @map("created_at")

  keyword SeoKeyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@index([keywordId, trackedAt])
  @@map("seo_rankings")
}

model SeoAlert {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  alertType String   @map("alert_type") // RANK_DROP, NEW_BACKLINK, COMPETITOR_UPDATE
  message   String   @db.Text
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([projectId])
  @@map("seo_alerts")
}

model SeoHistory {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  action    String
  userId    String?  @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  project SeoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("seo_history")
}

