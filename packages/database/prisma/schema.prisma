  name           String?
  status         String    @default("INVITED") // INVITED, ACTIVE, SUSPENDED
  lastLoginAt    DateTime? @map("last_login_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
  @@map("customer_portal_users")
}

model CustomerPortalActivity {
  id           String   @id @default(uuid())
  portalUserId String   @map("portal_user_id")
  action       String // e.g., 'VIEWED_INVOICE', 'APPROVED_CONTENT'
  details      Json?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([portalUserId])
  @@map("customer_portal_activity")
}

model MobileFeedback {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  appVersion  String   @map("app_version")
  rating      Int
  comment     String?  @db.Text
  attachments Json? // Array of log/screenshot URLs
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("mobile_feedback")
}

model MobileCrash {
  id         String   @id @default(uuid())
  deviceId   String   @map("device_id")
  appVersion String   @map("app_version")
  errorStack String   @map("error_stack") @db.Text
  metadata   Json?
  status     String   @default("NEW") // NEW, INVESTIGATING, RESOLVED
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([deviceId, status])
  @@map("mobile_crashes")
}

// =========================================================
// 33. ENTERPRISE AI MODEL MANAGEMENT, PROMPTOPS & CONTINUOUS LEARNING PLATFORM (MODULE 033)
// =========================================================

model AiOpsModel {
  id            String   @id @default(uuid())
  providerId    String   @map("provider_id")
  name          String
  modelCode     String   @unique @map("model_code") // e.g., 'gpt-4o'
  contextWindow Int      @map("context_window")
  capabilities  Json // Vision, Tools, Reasoning
  status        String   @default("ACTIVE") // ACTIVE, DEPRECATED, BETA
  createdAt     DateTime @default(now()) @map("created_at")

  provider   AiOpsProvider    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  routes     AiOpsRoute[]
  benchmarks AiOpsBenchmark[]

  @@map("aiops_models")
}

model AiOpsProvider {
  id        String   @id @default(uuid())
  name      String   @unique // 'OpenAI', 'Anthropic'
  status    String   @default("ACTIVE")
  apiKeyRef String?  @map("api_key_ref") // Reference to Security Secrets
  baseUrl   String?  @map("base_url")
  createdAt DateTime @default(now()) @map("created_at")

  models     AiOpsModel[]
  healthLogs AiOpsProviderHealth[]

  @@map("aiops_providers")
}

model AiOpsPrompt {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  category       String // SEO, CONTENT, RESEARCH
  status         String   @default("DRAFT") // DRAFT, ACTIVE, ARCHIVED
  createdAt      DateTime @default(now()) @map("created_at")

  versions    AiOpsPromptVersion[]
  evaluations AiOpsEvaluation[]
  experiments AiOpsExperiment[]

  @@index([organizationId, category])
  @@map("aiops_prompts")
}

model AiOpsPromptVersion {
  id            String   @id @default(uuid())
  promptId      String   @map("prompt_id")
  versionString String   @map("version_string")
  template      String   @db.Text
  variables     Json?
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt     DateTime @default(now()) @map("created_at")

  prompt AiOpsPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@index([promptId])
  @@map("aiops_prompt_versions")
}

model AiOpsEvaluation {
  id           String   @id @default(uuid())
  promptId     String   @map("prompt_id")
  executionId  String?  @map("execution_id")
  scorecard    Json // Quality, Fact Accuracy, Formatting
  overallScore Float    @map("overall_score")
  latencyMs    Int      @map("latency_ms")
  cost         Float    @default(0.0)
  createdAt    DateTime @default(now()) @map("created_at")

  prompt AiOpsPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@index([promptId])
  @@map("aiops_evaluations")
}

model AiOpsExperiment {
  id        String   @id @default(uuid())
  promptId  String   @map("prompt_id")
  name      String
  status    String   @default("RUNNING") // RUNNING, COMPLETED, CANCELLED
  variants  Json // A/B test definitions
  results   Json?
  winnerId  String?  @map("winner_id")
  createdAt DateTime @default(now()) @map("created_at")

  prompt AiOpsPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@index([promptId, status])
  @@map("aiops_experiments")
}

model AiOpsBenchmark {
  id            String   @id @default(uuid())
  modelId       String   @map("model_id")
  taskType      String   @map("task_type")
  accuracyScore Float    @map("accuracy_score")
  latencyScore  Float    @map("latency_score")
  costScore     Float    @map("cost_score")
  evaluatedAt   DateTime @default(now()) @map("evaluated_at")

  model AiOpsModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@index([modelId])
  @@map("aiops_benchmarks")
}

model AiOpsFeedback {
  id          String   @id @default(uuid())
  executionId String   @map("execution_id")
  rating      Int // 1 (Thumbs Down), 5 (Thumbs Up)
  category    String?
  comment     String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([executionId])
  @@map("aiops_feedback")
}

model AiOpsQuality {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  metric         String // HALLUCINATION_RATE, AVERAGE_SCORE
  value          Float
  measuredAt     DateTime @default(now()) @map("measured_at")

  @@index([organizationId, metric])
  @@map("aiops_quality")
}

model AiOpsCost {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  period         String // YYYY-MM
  totalCost      Float    @map("total_cost")
  totalTokens    Int      @map("total_tokens")
  breakdown      Json // By Provider, Model, Task
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, period])
  @@map("aiops_costs")
}

model AiOpsGuardrail {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  ruleType       String   @map("rule_type") // PROMPT_INJECTION, PII, TOXICITY
  action         String   @default("BLOCK") // BLOCK, LOG, ESCALATE
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId])
  @@map("aiops_guardrails")
}

model AiOpsRoute {
  id              String  @id @default(uuid())
  organizationId  String? @map("organization_id") // Null for global routes
  taskType        String  @map("task_type")
  primaryModelId  String  @map("primary_model_id")
  fallbackModelId String? @map("fallback_model_id")
  rules           Json? // Cost or Latency thresholds
  isActive        Boolean @default(true) @map("is_active")

  primaryModel AiOpsModel @relation(fields: [primaryModelId], references: [id], onDelete: Restrict)

  @@index([organizationId, taskType])
  @@map("aiops_routes")
}

model AiOpsProviderHealth {
  id         String   @id @default(uuid())
  providerId String   @map("provider_id")
  status     String // HEALTHY, DEGRADED, DOWN
  latencyMs  Int      @map("latency_ms")
  checkedAt  DateTime @default(now()) @map("checked_at")

  provider AiOpsProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, status])
  @@map("aiops_provider_health")
}

model AiOpsTrainingSuggestion {
  id              String   @id @default(uuid())
  promptId        String   @map("prompt_id")
  reason          String   @db.Text
  proposedChanges Json     @map("proposed_changes")
