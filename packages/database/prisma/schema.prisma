}

model OsSearch {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  userId          String   @map("user_id")
  query           String
  filters         Json?
  resultsCount    Int      @default(0) @map("results_count")
  executionTimeMs Int      @map("execution_time_ms")
  createdAt       DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId])
  @@map("os_search")
}

model OsWorkspace {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  description    String?  @db.Text
  ownerId        String   @map("owner_id")
  type           String // DEPARTMENT, PROJECT, TEAM
  settings       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("os_workspace")
}

model OsPreference {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  settings       Json?
  shortcuts      Json?
  theme          String   @default("SYSTEM")
  language       String   @default("en")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("os_preferences")
}

model OsBriefing {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  type           String // DAILY, WEEKLY, BOARD_REPORT
  content        String   @db.Text
  summary        String?  @db.Text
  metrics        Json?
  generatedAt    DateTime @default(now()) @map("generated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, type])
  @@map("os_briefings")
}

model OsReport {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  title          String
  category       String // FINANCIAL, OPERATIONAL, STRATEGIC
  contentUrl     String?  @map("content_url")
  metadata       Json?
  generatedAt    DateTime @default(now()) @map("generated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, category])
  @@map("os_reports")
}

model OsHealth {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  component      String // OVERALL, REVENUE, INFRASTRUCTURE, SECURITY
  score          Float // 0-100
  metrics        Json?
  evaluatedAt    DateTime @default(now()) @map("evaluated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, component, evaluatedAt])
  @@map("os_health")
}

model OsHistory {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  action         String // SEARCH, COMMAND, BRIEFING_GENERATED
  userId         String   @map("user_id")
  details        Json?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId])
  @@map("os_history")
}
