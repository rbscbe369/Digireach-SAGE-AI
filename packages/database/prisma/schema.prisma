// =========================================================
// 31. ENTERPRISE AI AGENTS & AUTONOMOUS TASK EXECUTION PLATFORM (MODULE 031)
// =========================================================

model AgentProfile {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  roleId         String?  @map("role_id")
  objective      String   @db.Text
  status         String   @default("ACTIVE") // ACTIVE, PAUSED, ARCHIVED, ERROR
  systemPrompt   String?  @map("system_prompt") @db.Text
  avatarUrl      String?  @map("avatar_url")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         AgentRole?           @relation(fields: [roleId], references: [id])
  tasks        AgentTask[]
  executions   AgentTaskExecution[]
  memories     AgentMemory[]
  evaluations  AgentEvaluation[]
  permissions  AgentPermission[]

  @@index([organizationId])
  @@map("agent_profiles")
}

model AgentRole {
  id           String   @id @default(uuid())
  name         String
  description  String?  @db.Text
  capabilities Json // Base capabilities (e.g., can_write, can_publish)
  createdAt    DateTime @default(now()) @map("created_at")

  agents AgentProfile[]

  @@map("agent_roles")
}

model AgentMemory {
  id         String    @id @default(uuid())
  agentId    String    @map("agent_id")
  memoryType String    @map("memory_type") // SHORT_TERM, LONG_TERM, WORKSPACE, PROJECT
  content    String    @db.Text
  vectorId   String?   @map("vector_id") // Link to Pinecone/Vector DB
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  agent AgentProfile @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, memoryType])
  @@map("agent_memories")
}

model AgentTask {
  id          String    @id @default(uuid())
  agentId     String    @map("agent_id")
  title       String
  description String    @db.Text
  status      String    @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED, NEEDS_APPROVAL
  priority    String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  dueDate     DateTime? @map("due_date")
  createdAt   DateTime  @default(now()) @map("created_at")

  agent      AgentProfile         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  plans      AgentPlan[]
  executions AgentTaskExecution[]

  @@index([agentId, status])
  @@map("agent_tasks")
}

model AgentPlan {
  id              String   @id @default(uuid())
  taskId          String   @map("task_id")
  steps           Json // Array of steps to execute
  estimatedTokens Int?     @map("estimated_tokens")
  confidenceScore Float?   @map("confidence_score")
  status          String   @default("PROPOSED") // PROPOSED, APPROVED, REJECTED
  createdAt       DateTime @default(now()) @map("created_at")

  task AgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("agent_plans")
}

model AgentTaskExecution {
  id          String    @id @default(uuid())
  agentId     String    @map("agent_id")
  taskId      String?   @map("task_id")
  status      String    @default("RUNNING") // RUNNING, SUCCESS, FAILED, PAUSED
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")
  logs        Json? // Execution trace
  cost        Float     @default(0.0)
  createdAt   DateTime  @default(now()) @map("created_at")

  agent     AgentProfile     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  task      AgentTask?       @relation(fields: [taskId], references: [id])
  toolUsage AgentToolUsage[]

  @@index([agentId, status])
  @@map("agent_task_executions")
}

model AgentEvaluation {
  id              String   @id @default(uuid())
  agentId         String   @map("agent_id")
  executionId     String?  @map("execution_id")
  accuracyScore   Float    @map("accuracy_score")
  reasoningScore  Float    @map("reasoning_score")
  efficiencyScore Float    @map("efficiency_score")
  feedback        String?  @db.Text
  evaluatedAt     DateTime @default(now()) @map("evaluated_at")

  agent AgentProfile @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@map("agent_evaluations")
}

model AgentFeedback {
  id          String   @id @default(uuid())
  executionId String   @map("execution_id")
  userId      String   @map("user_id")
  rating      Int // 1-5
  comment     String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([executionId])
  @@map("agent_feedback")
}

model AgentPermission {
  id               String   @id @default(uuid())
  agentId          String   @map("agent_id")
  resource         String // Module or API (e.g., 'CRM', 'PUBLISHING')
  action           String // READ, WRITE, APPROVE
  requiresApproval Boolean  @default(true) @map("requires_approval")
  createdAt        DateTime @default(now()) @map("created_at")

  agent AgentProfile @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@map("agent_permissions")
}

model AgentToolUsage {
  id           String   @id @default(uuid())
  executionId  String   @map("execution_id")
  toolName     String   @map("tool_name")
  inputParams  Json?    @map("input_params")
  outputResult Json?    @map("output_result")
  durationMs   Int      @map("duration_ms")
  createdAt    DateTime @default(now()) @map("created_at")

  execution AgentTaskExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@map("agent_tool_usage")
}

model AgentMarketplace {
  id          String   @id @default(uuid())
  agentId     String   @map("agent_id") // Source agent template
  name        String
  description String   @db.Text
  category    String
  downloads   Int      @default(0)
  isPublic    Boolean  @default(false) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("agent_marketplace")
}

model AgentVersion {
  id             String   @id @default(uuid())
  agentId        String   @map("agent_id")
  versionString  String   @map("version_string")
  configSnapshot Json     @map("config_snapshot")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([agentId])
  @@map("agent_versions")
}

model AgentHistory {
  id        String   @id @default(uuid())
  agentId   String   @map("agent_id")
  action    String // CREATED, UPDATED, DELETED, EXECUTED
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([agentId])
  @@map("agent_history")
}

model AgentGovernance {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  ruleType       String   @map("rule_type") // BUDGET_LIMIT, TIME_LIMIT, APPROVAL_POLICY
  config         Json
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId])
  @@map("agent_governance")
}

// =========================================================
// 32. ENTERPRISE MOBILE APPS, CUSTOMER PORTAL & AI VOICE ASSISTANT PLATFORM (MODULE 032)
// =========================================================

model MobileDevice {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  deviceToken  String?  @unique @map("device_token") // Push notification token
  os           String // iOS, Android, Web
  osVersion    String   @map("os_version")
  appVersion   String   @map("app_version")
  deviceModel  String   @map("device_model")
  status       String   @default("ACTIVE") // ACTIVE, INACTIVE, REVOKED
  lastActiveAt DateTime @default(now()) @map("last_active_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions      MobileSession[]
  notifications MobileNotification[]
  syncLogs      MobileSync[]

  @@index([userId])
  @@map("mobile_devices")
}

model MobileSession {
  id        String   @id @default(uuid())
  deviceId  String   @map("device_id")
  sessionId String   @unique @map("session_id")
  ipAddress String?  @map("ip_address")
  status    String   @default("ACTIVE")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  device MobileDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@map("mobile_sessions")
}

model MobileNotification {
  id        String    @id @default(uuid())
  deviceId  String    @map("device_id")
  title     String
  body      String    @db.Text
  data      Json? // Deep linking data
  status    String    @default("PENDING") // PENDING, SENT, FAILED, READ
  sentAt    DateTime? @map("sent_at")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  device MobileDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, status])
  @@map("mobile_notifications")
}

model MobileSync {
  id            String   @id @default(uuid())
  deviceId      String   @map("device_id")
  entityType    String   @map("entity_type") // e.g., CRM_LEADS, OFFLINE_DRAFTS
  lastSyncToken String?  @map("last_sync_token")
  status        String   @default("SUCCESS") // SUCCESS, FAILED, CONFLICT
  recordsSynced Int      @default(0) @map("records_synced")
  createdAt     DateTime @default(now()) @map("created_at")

  device MobileDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@map("mobile_sync")
}

model MobileOfflineData {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  payload    Json // The offline change
  operation  String // CREATE, UPDATE, DELETE
  status     String   @default("PENDING") // PENDING, SYNCED, CONFLICT
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, status])
  @@map("mobile_offline")
}

model VoiceSession {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  durationSeconds Int      @default(0) @map("duration_seconds")
  status          String   @default("ACTIVE") // ACTIVE, COMPLETED, DROPPED
  transcript      String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at")

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  commands VoiceCommand[]

  @@index([userId])
  @@map("voice_sessions")
}

model VoiceCommand {
  id               String   @id @default(uuid())
  sessionId        String   @map("session_id")
  commandText      String   @map("command_text") @db.Text
  intent           String? // Extracted intent (e.g., 'CREATE_BLOG', 'SHOW_ANALYTICS')
  parameters       Json? // Extracted entities
  responseAudioUrl String?  @map("response_audio_url")
  status           String   @default("SUCCESS") // SUCCESS, FAILED, UNRECOGNIZED
  createdAt        DateTime @default(now()) @map("created_at")

  session VoiceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("voice_commands")
}

model CustomerPortalUser {
