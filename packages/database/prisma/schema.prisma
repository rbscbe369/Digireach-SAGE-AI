  @@index([projectId])
  @@map("ai_search_citation_reports")
}

model AiSearchVoiceReport {
  id                  String   @id @default(uuid())
  projectId           String   @map("project_id")
  conversationalScore Float    @default(0.0) @map("conversational_score")
