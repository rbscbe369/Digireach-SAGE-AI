  voiceQueries        Json     @map("voice_queries") // Natural language variations
  createdAt           DateTime @default(now()) @map("created_at")

  project AiSearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("ai_search_voice_reports")
}

model AiSearchChunkReport {
  id                     String   @id @default(uuid())
  projectId              String   @map("project_id")
  chunkOptimizationScore Float    @default(0.0) @map("chunk_optimization_score")
  chunks                 Json // Hierarchical structure optimized for RAG
  createdAt              DateTime @default(now()) @map("created_at")

  project AiSearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("ai_search_chunk_reports")
}

model AiSearchRecommendation {
  id           String   @id @default(uuid())
