generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================
// 1. SYSTEM & GLOBAL TABLES
// =========================================================

model Organization {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  members          OrganizationMember[]
  subscriptions    Subscription[]
  apiKeys          ApiKey[]
  auditLogs        AuditLog[]
  researchProjects ResearchProject[]
  blogs            Blog[]

  // Workspace relations
  settings                WorkspaceSettings?
  branding                WorkspaceBranding?
  storage                 WorkspaceStorage?
  domains                 WorkspaceDomain[]
  integrations            WorkspaceIntegration[]
  security                WorkspaceSecurity?
  preferences             WorkspacePreferences?
  departments             WorkspaceDepartment[]
  invitations             WorkspaceInvitation[]
  QueueJob                QueueJob[]
  ProviderUsage           ProviderUsage[]
  CostTracking            CostTracking[]
  Source                  Source[]
  Citation                Citation[]
  CitationStyle           CitationStyle[]
  KnowledgeNode           KnowledgeNode[]
  KnowledgeEdge           KnowledgeEdge[]
  KnowledgeCluster        KnowledgeCluster[]
  KnowledgeHistory        KnowledgeHistory[]
  AiAgent                 AiAgent[]
  WorkflowTemplate        WorkflowTemplate[]
  WorkflowExecution       WorkflowExecution[]
  PromptLibrary           PromptLibrary[]
  AiProvider              AiProvider[]
  ProviderUsageMetrics    ProviderUsageMetrics[]
  ProviderFailover        ProviderFailover[]
  RoutingRule             RoutingRule[]
  WorkspaceAiPolicy       WorkspaceAiPolicy?
  PromptEntity            PromptEntity[]
  PromptCategory          PromptCategory[]
  QualityReview           QualityReview[]
  QualityScoreRecord      QualityScoreRecord[]
  ApprovalWorkflow        ApprovalWorkflow[]
  TokenUsageRecord        TokenUsageRecord[]
  WorkspaceBudget         WorkspaceBudget[]
  OptimizationRec         OptimizationRecommendation[]
  BudgetAlert             BudgetAlert[]
  ContentProject          ContentProject[]
  ContentDocument         ContentDocument[]
  ContentTemplate         ContentTemplate[]
  BlogProject             BlogProject[]
  BlogTemplate            BlogTemplate[]
  LandingProject          LandingProject[]
  LandingTemplate         LandingTemplate[]
  SocialProject           SocialProject[]
  SocialCampaign          SocialCampaign[]
  EmailProject            EmailProject[]
  EmailAudience           EmailAudience[]
  VideoProject            VideoProject[]
  PodcastProject          PodcastProject[]
  PublishingProject       PublishingProject[]
  PublishingChannel       PublishingChannel[]
  PublishingCampaign      PublishingCampaign[]
  AnalyticsDashboard      AnalyticsDashboard[]
  AnalyticsReport         AnalyticsReport[]
  AnalyticsAlert          AnalyticsAlert[]
  SeoProject              SeoProject[]
  AiSearchProject         AiSearchProject[]
  AutomationWorkflow      AutomationWorkflow[]
  CrmLead                 CrmLead[]
  IntegrationAccount      IntegrationAccount[]
  BillingSubscriptions    BillingSubscription[]
  SecurityAuditLogs       SecurityAuditLog[]
  AgentProfiles           AgentProfile[]
  CustomerPortalUsers     CustomerPortalUser[]
  KnowledgeDocuments      KnowledgeDocument[]
  StudioProject           StudioProject[]
  DeveloperAccount        DeveloperAccount[]
  DataSource              DataSource[]
  BiDashboard             BiDashboard[]
  CustomerProfile         CustomerProfile[]
  SupportTicket           SupportTicket[]
  CsKnowledgeArticle      CsKnowledgeArticle[]
  CustomerFeedback        CustomerFeedback[]
  CustomerPlaybook        CustomerPlaybook[]
  SupportAnalytics        SupportAnalytics[]
  FinanceAccount          FinanceAccount[]
  FinanceJournal          FinanceJournal[]
  FinanceInvoice          FinanceInvoice[]
  FinancePayment          FinancePayment[]
  FinanceReceivable       FinanceReceivable[]
  FinancePayable          FinancePayable[]
  FinanceExpense          FinanceExpense[]
  FinanceInventory        FinanceInventory[]
  FinanceAsset            FinanceAsset[]
  FinanceBudget           FinanceBudget[]
  FinanceTax              FinanceTax[]
  FinanceForecast         FinanceForecast[]
  FinanceReport           FinanceReport[]
  HrEmployee              HrEmployee[]
  HrDepartment            HrDepartment[]
  HrPosition              HrPosition[]
  HrJob                   HrJob[]
  HrApplicant             HrApplicant[]
  HrGoal                  HrGoal[]
  HrTraining              HrTraining[]
  HrSurvey                HrSurvey[]
  HrReport                HrReport[]
  IotDevice               IotDevice[]
  IotGateway              IotGateway[]
  IotAsset                IotAsset[]
  IotFleet                IotFleet[]
  IotGeofence             IotGeofence[]
  IotEdgeModel            IotEdgeModel[]
  IotDigitalTwin          IotDigitalTwin[]
  IotAlert                IotAlert[]
  IotFirmware             IotFirmware[]
  MlProject               MlProject[]
  MlFeatureStore          MlFeatureStore[]
  MlRegistry              MlRegistry[]
  GlobalLanguage          GlobalLanguage[]
  GlobalRegion            GlobalRegion[]
  GlobalCurrency          GlobalCurrency[]
  GlobalTranslation       GlobalTranslation[]
  GlobalTranslationMemory GlobalTranslationMemory[]
  GlobalLocalization      GlobalLocalization[]
  GlobalTaxRule           GlobalTaxRule[]
  GlobalCompliance        GlobalCompliance[]
  GlobalDeployment        GlobalDeployment[]
  GlobalAnalytics         GlobalAnalytics[]
  FutureCompute           FutureCompute[]
  FutureQuantum           FutureQuantum[]
  FutureHardware          FutureHardware[]
  FutureSimulation        FutureSimulation[]
  FutureResearch          FutureResearch[]
  FutureInnovation        FutureInnovation[]
  FutureRoadmap           FutureRoadmap[]
  FutureConnector         FutureConnector[]
  FutureGreenMetric       FutureGreenMetric[]
  GrcPolicy               GrcPolicy[]
  GrcRisk                 GrcRisk[]
  GrcControl              GrcControl[]
  GrcCompliance           GrcCompliance[]
  GrcLegal                GrcLegal[]
  GrcContract             GrcContract[]
  GrcAudit                GrcAudit[]
  GrcPrivacy              GrcPrivacy[]
  GrcIncident             GrcIncident[]
  GrcEsg                  GrcEsg[]
  GrcReport               GrcReport[]
  InnovationIdea          InnovationIdea[]
  InnovationProject       InnovationProject[]
  InnovationResearch      InnovationResearch[]
  InnovationPrototype     InnovationPrototype[]
  InnovationBeta          InnovationBeta[]
  InnovationIncubator     InnovationIncubator[]
  InnovationPortfolio     InnovationPortfolio[]
  InnovationPatent        InnovationPatent[]
  InnovationKnowledge     InnovationKnowledge[]
  EcosystemPartner        EcosystemPartner[]
  EcosystemAgency         EcosystemAgency[]
  EcosystemReseller       EcosystemReseller[]
  EcosystemFranchise      EcosystemFranchise[]
  EcosystemAffiliate      EcosystemAffiliate[]
  EcosystemDeal           EcosystemDeal[]
  EcosystemTraining       EcosystemTraining[]
  EcosystemReward         EcosystemReward[]
  EcosystemMarketplace    EcosystemMarketplace[]
  EcosystemReport         EcosystemReport[]
  OsDashboard             OsDashboard[]
  OsMemory                OsMemory[]
  OsTimeline              OsTimeline[]
  OsDecision              OsDecision[]
  OsNotification          OsNotification[]
  OsSearch                OsSearch[]
  OsWorkspace             OsWorkspace[]
  OsPreference            OsPreference[]
  OsBriefing              OsBriefing[]
  OsReport                OsReport[]
  OsHealth                OsHealth[]
  OsHistory               OsHistory[]

  @@index([slug])
  @@map("organizations")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  createdBy     String?   @map("created_by")
  updatedBy     String?   @map("updated_by")

  sessions      Session[]
  MobileDevices MobileDevice[]
  VoiceSessions VoiceSession[]
  oauthAccounts OAuthAccount[]
  memberships   OrganizationMember[]
  auditLogs     AuditLog[]
  apiKeys       ApiKey[]
  SecurityUser  SecurityUser?

  @@map("users")
}

model OrganizationMember {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  userId         String    @map("user_id")
  roleId         String    @map("role_id")
  departmentId   String?   @map("department_id")
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  createdBy      String?   @map("created_by")
  updatedBy      String?   @map("updated_by")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role                 @relation(fields: [roleId], references: [id])
  department   WorkspaceDepartment? @relation(fields: [departmentId], references: [id])

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("organization_members")
}

model Role {
  id             String    @id @default(uuid())
  organizationId String?   @map("organization_id")
  name           String
  description    String?
  permissions    Json?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  createdBy      String?   @map("created_by")
  updatedBy      String?   @map("updated_by")

  members OrganizationMember[]

  @@map("roles")
}

model Session {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  sessionToken String    @unique @map("session_token")
  expiresAt    DateTime  @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model OAuthAccount {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  provider          String
  providerAccountId String   @map("provider_account_id")
  accessToken       String?  @map("access_token")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?  @map("organization_id")
  userId         String?  @map("user_id")
  action         String
  entityId       String?  @map("entity_id")
  entityType     String?  @map("entity_type")
  details        Json?
  ipAddress      String?  @map("ip_address")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([createdAt])
  @@map("audit_logs")
}

model ApiKey {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  userId         String    @map("user_id")
  name           String
  keyHash        String    @unique @map("key_hash")
  permissions    Json?
  lastUsedAt     DateTime? @map("last_used_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  createdBy      String?   @map("created_by")
  updatedBy      String?   @map("updated_by")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("api_keys")
}

// =========================================================
// 2. SUBSCRIPTION TABLES
// =========================================================

model Subscription {
  id                 String    @id @default(uuid())
  organizationId     String    @map("organization_id")
  planId             String    @map("plan_id")
  status             String // active, canceled, past_due
  currentPeriodStart DateTime  @map("current_period_start")
  currentPeriodEnd   DateTime  @map("current_period_end")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")
  createdBy          String?   @map("created_by")
  updatedBy          String?   @map("updated_by")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@map("subscriptions")
}

// =========================================================
// 3. RESEARCH ENGINE
// =========================================================

model ResearchProject {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  name           String
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  createdBy      String?   @map("created_by")
  updatedBy      String?   @map("updated_by")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions     ResearchSession[]
  tags         ResearchTag[]
  bookmarks    ResearchBookmark[]
  comments     ResearchComment[]
  activity     ResearchActivity[]
  reports      ResearchReport[]

  @@index([organizationId])
  @@index([status])
  @@map("research_projects")
}

model ResearchSession {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  status    String   @default("QUEUED")
  depth     String   @default("STANDARD")
  inputs    Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("research_sessions")
}

model ResearchReport {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  title     String
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("research_reports")
}

model ResearchExport {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  format         String
  url            String
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId])
  @@map("research_exports")
}

model ResearchTemplate {
  id             String   @id @default(uuid())
  organizationId String?  @map("organization_id") // Nullable for global templates
  name           String
  config         Json
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("research_templates")
}

model ResearchTag {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  project ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("research_tags")
}

model ResearchBookmark {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  url       String
  title     String?
  createdAt DateTime @default(now()) @map("created_at")

  project ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("research_bookmarks")
}

model ResearchComment {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  project ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("research_comments")
}

model ResearchActivity {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  action    String
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  project ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("research_activity")
}

// =========================================================
// 4. CONTENT STUDIO
// =========================================================

model Blog {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  title          String
  slug           String
  content        String?   @db.Text
  status         String    @default("DRAFT")
  publishedAt    DateTime? @map("published_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  createdBy      String?   @map("created_by")
  updatedBy      String?   @map("updated_by")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([status])
  @@map("blogs")
}

// =========================================================
// 5. WORKSPACE MANAGEMENT (MODULE 004)
// =========================================================

model WorkspaceSettings {
  id             String   @id @default(uuid())
  organizationId String   @unique @map("organization_id")
  businessName   String?
  industry       String?
  website        String?
  supportEmail   String?
  timezone       String   @default("UTC")
  language       String   @default("en")
  currency       String   @default("USD")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("workspace_settings")
}

model WorkspaceBranding {
  id             String   @id @default(uuid())
  organizationId String   @unique @map("organization_id")
  logoUrl        String?
  faviconUrl     String?
  primaryColor   String?
  secondaryColor String?
  fontFamily     String?
  customDomain   String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("workspace_branding")
}

model WorkspaceStorage {
  id             String   @id @default(uuid())
  organizationId String   @unique @map("organization_id")
  totalAllocated BigInt   @default(10737418240) // 10GB default
  usedBytes      BigInt   @default(0)
  fileCount      Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("workspace_storage")
}

model WorkspaceDomain {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  domain         String   @unique
  status         String   @default("PENDING")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("workspace_domains")
}

model WorkspaceIntegration {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  provider       String // openai, stripe, etc
  status         String    @default("DISCONNECTED")
  config         Json?
  lastSyncAt     DateTime? @map("last_sync_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  @@map("workspace_integrations")
}

model WorkspaceSecurity {
  id             String   @id @default(uuid())
  organizationId String   @unique @map("organization_id")
  require2FA     Boolean  @default(false)
  sessionTimeout Int      @default(86400) // 24 hours
  allowedIps     String[]
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("workspace_security")
}

model WorkspacePreferences {
  id             String   @id @default(uuid())
  organizationId String   @unique @map("organization_id")
  emailReports   Boolean  @default(true)
  theme          String   @default("system")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("workspace_preferences")
}

model WorkspaceDepartment {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  name           String
  description    String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      OrganizationMember[]

  @@index([organizationId])
  @@map("workspace_departments")
}

model WorkspaceInvitation {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  email          String
  roleId         String   @map("role_id")
  token          String   @unique
  status         String   @default("PENDING")
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdBy      String?  @map("created_by")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("workspace_invitations")
}

// =========================================================
// 6. QUEUE & AI ORCHESTRATION ENGINE (MODULE 006)
// =========================================================

model QueueJob {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  name           String
  queue          String // research, content, seo, etc
  priority       Int       @default(0) // 0=normal, higher=priority
  status         String    @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED
  payload        Json?
  result         Json?
  error          String?   @db.Text
  progress       Int       @default(0)
  retryCount     Int       @default(0) @map("retry_count")
  startedAt      DateTime? @map("started_at")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  logs         JobLog[]
  failures     JobFailure[]

  @@index([organizationId])
  @@index([queue, status])
  @@map("queue_jobs")
}

model QueueWorker {
  id            String   @id @default(uuid())
  name          String
  queue         String
  status        String   @default("IDLE") // IDLE, BUSY, PAUSED, OFFLINE
  currentJobId  String?  @map("current_job_id")
  cpuUsage      Float?   @map("cpu_usage")
  memoryUsage   Float?   @map("memory_usage")
  lastHeartbeat DateTime @default(now()) @map("last_heartbeat")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([queue])
  @@map("queue_workers")
}

model JobLog {
  id        String   @id @default(uuid())
  jobId     String   @map("job_id")
  level     String // INFO, WARN, ERROR
  message   String   @db.Text
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  job QueueJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("job_logs")
}

model JobFailure {
  id           String   @id @default(uuid())
  jobId        String   @map("job_id")
  errorType    String   @map("error_type")
  errorMessage String   @map("error_message") @db.Text
  stackTrace   String?  @map("stack_trace") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  job QueueJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("job_failures")
}

model ProviderUsage {
  id               String   @id @default(uuid())
  organizationId   String   @map("organization_id")
  provider         String // openai, anthropic
  model            String // gpt-4, claude-3
  tokensPrompt     Int      @default(0) @map("tokens_prompt")
  tokensCompletion Int      @default(0) @map("tokens_completion")
  costUsd          Float    @default(0.0) @map("cost_usd")
  latencyMs        Int      @default(0) @map("latency_ms")
  createdAt        DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("provider_usage")
}

model CostTracking {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  module         String // RESEARCH, CONTENT
  amountUsd      Float    @map("amount_usd")
  currency       String   @default("USD")
  date           DateTime @db.Date
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, date])
  @@map("cost_tracking")
}

// =========================================================
// 7. SOURCE MANAGER (MODULE 007)
// =========================================================

model Source {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  title          String
  url            String    @db.Text
  domain         String
  category       String
  publisher      String?
  author         String?
  publishedAt    DateTime? @map("published_at")
  language       String?   @default("en")
  country        String?
  trustScore     Float     @default(0.0) @map("trust_score")
  status         String    @default("PENDING") // PENDING, VERIFIED, REJECTED, DUPLICATE
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  metadata         SourceMetadata?
  verificationLogs SourceVerificationLog[]
  duplicates       SourceDuplicate[]
  relationships    SourceRelationship[]
  Citation         Citation[]
  KnowledgeNode    KnowledgeNode[]

  @@unique([organizationId, url])
  @@index([organizationId])
  @@index([status])
  @@index([trustScore])
  @@map("sources")
}

model SourceMetadata {
  id            String   @id @default(uuid())
  sourceId      String   @unique @map("source_id")
  summary       String?  @db.Text
  canonicalUrl  String?  @map("canonical_url")
  schemaData    Json?    @map("schema_data")
  extractedText String?  @map("extracted_text") @db.Text
  brokenLink    Boolean  @default(false) @map("broken_link")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@map("source_metadata")
}

model SourceVerificationLog {
  id        String   @id @default(uuid())
  sourceId  String   @map("source_id")
  action    String // VERIFIED, REJECTED, UPDATED
  details   Json?
  userId    String?  @map("user_id") // Null if automated
  createdAt DateTime @default(now()) @map("created_at")

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@map("source_verification_logs")
}

model SourceDuplicate {
  id           String   @id @default(uuid())
  sourceId     String   @map("source_id")
  duplicateUrl String   @map("duplicate_url")
  similarity   Float
  createdAt    DateTime @default(now()) @map("created_at")

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@map("source_duplicates")
}

model SourceRelationship {
  id         String   @id @default(uuid())
  sourceId   String   @map("source_id")
  entityType String   @map("entity_type") // RESEARCH_PROJECT, KNOWLEDGE_NODE, CITATION
  entityId   String   @map("entity_id")
  createdAt  DateTime @default(now()) @map("created_at")

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([entityType, entityId])
  @@map("source_relationships")
}

// =========================================================
// 8. CITATION ENGINE (MODULE 008)
// =========================================================

model Citation {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  sourceId       String    @map("source_id")
  title          String
  type           String // Website, Paper, Book, etc
  style          String // APA, MLA, Chicago
  formattedText  String    @map("formatted_text") @db.Text
  inTextCitation String?   @map("in_text_citation")
  author         String?
  publisher      String?
  url            String?   @db.Text
  doi            String?
  isbn           String?
  usageCount     Int       @default(0) @map("usage_count")
  status         String    @default("PENDING") // PENDING, VALIDATED, BROKEN, OUTDATED
  lastValidated  DateTime? @map("last_validated")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source       Source               @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  metadata     CitationMetadata?
  validations  CitationValidation[]
  links        CitationLink[]

  @@index([organizationId])
  @@index([sourceId])
  @@index([status])
  @@map("citations")
}

model CitationStyle {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String // "Custom Enterprise Style"
  template       Json
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("citation_styles")
}

model CitationMetadata {
  id         String    @id @default(uuid())
  citationId String    @unique @map("citation_id")
  issue      String?
  volume     String?
  pages      String?
  edition    String?
  accessedAt DateTime? @map("accessed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  citation Citation @relation(fields: [citationId], references: [id], onDelete: Cascade)

  @@map("citation_metadata")
}

model CitationValidation {
  id         String   @id @default(uuid())
  citationId String   @map("citation_id")
  status     String // VALID, BROKEN_LINK, OUTDATED, MISSING_METADATA
  report     String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  citation Citation @relation(fields: [citationId], references: [id], onDelete: Cascade)

  @@index([citationId])
  @@map("citation_validations")
}

model CitationLink {
  id         String   @id @default(uuid())
  citationId String   @map("citation_id")
  entityType String   @map("entity_type") // ARTICLE, FACT, STATISTIC
  entityId   String   @map("entity_id")
  createdAt  DateTime @default(now()) @map("created_at")

  citation Citation @relation(fields: [citationId], references: [id], onDelete: Cascade)

  @@index([citationId])
  @@index([entityType, entityId])
  @@map("citation_links")
}

// =========================================================
// 9. KNOWLEDGE GRAPH ENGINE (MODULE 009)
// =========================================================

model KnowledgeNode {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  type           String // Topic, Company, Fact, Person, etc
  name           String // Primary label
  description    String?  @db.Text
  sourceId       String?  @map("source_id")
  trustScore     Float    @default(0.0) @map("trust_score")
  confidence     Float    @default(0.0)
  usageCount     Int      @default(0) @map("usage_count")
  metadata       Json? // Stores specialized data for facts, statistics, quotes
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source       Source?      @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  edgesOut   KnowledgeEdge[]      @relation("SourceEdges")
  edgesIn    KnowledgeEdge[]      @relation("TargetEdges")
  embeddings KnowledgeEmbedding[]
  clusters   KnowledgeCluster[]

  @@index([organizationId])
  @@index([type])
  @@index([name])
  @@map("knowledge_nodes")
}

model KnowledgeEdge {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  sourceNodeId   String   @map("source_node_id")
  targetNodeId   String   @map("target_node_id")
  relationship   String // belongs_to, mentions, competes_with
  weight         Float    @default(1.0)
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceNode   KnowledgeNode @relation("SourceEdges", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode   KnowledgeNode @relation("TargetEdges", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@unique([sourceNodeId, targetNodeId, relationship])
  @@index([organizationId])
  @@map("knowledge_edges")
}

model KnowledgeEmbedding {
  id         String   @id @default(uuid())
  nodeId     String   @map("node_id")
  model      String // openai-text-embedding-3-small, etc
  vectorData Json // Fallback/abstraction for pgvector Float[] until pgvector is explicitly active
  createdAt  DateTime @default(now()) @map("created_at")

  node KnowledgeNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId])
  @@map("knowledge_embeddings")
}

model KnowledgeCluster {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  description    String?  @db.Text
  nodeId         String   @map("node_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  node         KnowledgeNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([nodeId])
  @@map("knowledge_clusters")
}

model KnowledgeHistory {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  action         String // CREATED, MERGED, UPDATED
  entityType     String   @map("entity_type") // NODE, EDGE
  entityId       String   @map("entity_id")
  details        Json?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([entityType, entityId])
  @@map("knowledge_history")
}

// =========================================================
// 10. AI RESEARCH AGENT ORCHESTRATOR (MODULE 010)
// =========================================================

model AiAgent {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id") // Could be system-wide if Organization is System
  name           String   @unique
  description    String?  @db.Text
  status         String   @default("AVAILABLE") // AVAILABLE, BUSY, PAUSED, DISABLED, FAILED
  version        String   @default("1.0.0")
  capabilities   Json? // Array of supported capabilities
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  executions   AgentExecution[]

  @@index([organizationId])
  @@index([status])
  @@map("ai_agents")
}

model WorkflowTemplate {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  description    String?  @db.Text
  definition     Json // The DAG or sequence of tasks
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  executions   WorkflowExecution[]

  @@index([organizationId])
  @@map("workflow_templates")
}

model WorkflowExecution {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  templateId     String?   @map("template_id")
  status         String    @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED, CANCELLED
  input          Json?
  output         Json?
  startedAt      DateTime? @map("started_at")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template        WorkflowTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  agentExecutions AgentExecution[]

  @@index([organizationId])
  @@index([status])
  @@map("workflow_executions")
}

model AgentExecution {
  id                  String    @id @default(uuid())
  workflowExecutionId String    @map("workflow_execution_id")
  agentId             String    @map("agent_id")
  status              String    @default("PENDING")
  input               Json?
  output              Json?
  tokensUsed          Int       @default(0) @map("tokens_used")
  startedAt           DateTime? @map("started_at")
  completedAt         DateTime? @map("completed_at")

  workflowExecution WorkflowExecution @relation(fields: [workflowExecutionId], references: [id], onDelete: Cascade)
  agent             AiAgent           @relation(fields: [agentId], references: [id])
  steps             ExecutionStep[]

  @@index([workflowExecutionId])
  @@index([agentId])
  @@map("agent_executions")
}

model ExecutionStep {
  id               String   @id @default(uuid())
  agentExecutionId String   @map("agent_execution_id")
  action           String
  result           Json?
  createdAt        DateTime @default(now()) @map("created_at")

  agentExecution AgentExecution @relation(fields: [agentExecutionId], references: [id], onDelete: Cascade)

  @@index([agentExecutionId])
  @@map("execution_steps")
}

model PromptLibrary {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  description    String?  @db.Text
  template       String   @db.Text
  version        String   @default("1.0.0")
  inputVariables Json?    @map("input_variables")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("prompt_library")
}

model QualityScore {
  id         String   @id @default(uuid())
  targetId   String   @map("target_id")
  targetType String   @map("target_type") // e.g., AGENT_EXECUTION
  score      Float
  feedback   String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([targetType, targetId])
  @@map("quality_scores")
}

// =========================================================
// 11. MULTI-LLM ROUTER & AI PROVIDER ENGINE (MODULE 011)
// =========================================================

model AiProvider {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String   @unique // openai, anthropic, gemini
  baseUrl        String?  @map("base_url")
  status         String   @default("ACTIVE") // ACTIVE, DEGRADED, OFFLINE
  latencyMs      Int      @default(0) @map("latency_ms")
  successRate    Float    @default(100.0) @map("success_rate")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  models       ProviderModel[]
  healthLogs   ProviderHealth[]
  failovers    ProviderFailover[]
  usage        ProviderUsageMetrics[]

  @@index([organizationId])
  @@map("ai_providers")
}

model ProviderModel {
  id              String   @id @default(uuid())
  providerId      String   @map("provider_id")
  modelName       String   @map("model_name") // gpt-4o, claude-3-opus
  version         String?
  contextWindow   Int      @map("context_window")
  maxOutput       Int      @map("max_output")
  inputCostPer1k  Float    @map("input_cost_per_1k")
  outputCostPer1k Float    @map("output_cost_per_1k")
  capabilities    Json // JSON array: ["vision", "streaming", "json_mode"]
  status          String   @default("AVAILABLE")
  createdAt       DateTime @default(now()) @map("created_at")

  provider     AiProvider          @relation(fields: [providerId], references: [id], onDelete: Cascade)
  benchmarks   ProviderBenchmark[]
  routingRules RoutingRule[]       @relation("SelectedModel")

  @@unique([providerId, modelName])
  @@index([providerId])
  @@map("provider_models")
}

model ProviderHealth {
  id         String   @id @default(uuid())
  providerId String   @map("provider_id")
  status     String // HEALTHY, DEGRADED, OFFLINE
  latencyMs  Int      @map("latency_ms")
  errorCount Int      @default(0) @map("error_count")
  checkedAt  DateTime @default(now()) @map("checked_at")

  provider AiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, checkedAt])
  @@map("provider_health")
}

model ProviderBenchmark {
  id             String   @id @default(uuid())
  modelId        String   @map("model_id")
  scoreSpeed     Float    @map("score_speed")
  scoreAccuracy  Float    @map("score_accuracy")
  scoreReasoning Float    @map("score_reasoning")
  scoreJson      Float    @map("score_json")
  runAt          DateTime @default(now()) @map("run_at")

  model ProviderModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@index([modelId])
  @@map("provider_benchmarks")
}

model ProviderUsageMetrics {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  providerId     String   @map("provider_id")
  date           DateTime @db.Date
  requestsCount  Int      @default(0) @map("requests_count")
  inputTokens    Int      @default(0) @map("input_tokens")
  outputTokens   Int      @default(0) @map("output_tokens")
  totalCost      Float    @default(0.0) @map("total_cost")

  provider     AiProvider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, providerId, date])
  @@map("provider_usage_metrics")
}

model ProviderFailover {
  id                 String   @id @default(uuid())
  organizationId     String   @map("organization_id")
  primaryProviderId  String   @map("primary_provider_id")
  fallbackProviderId String   @map("fallback_provider_id")
  reason             String   @db.Text
  occurredAt         DateTime @default(now()) @map("occurred_at")

  primaryProvider AiProvider   @relation(fields: [primaryProviderId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([primaryProviderId])
  @@map("provider_failovers")
}

model RoutingRule {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  priority       Int      @default(1)
  conditions     Json // Rules for matching task type, cost, etc.
  modelId        String   @map("model_id")
  fallbackChain  Json?    @map("fallback_chain") // Array of model IDs to fallback to
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  model        ProviderModel @relation("SelectedModel", fields: [modelId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("routing_rules")
}

model WorkspaceAiPolicy {
  id               String   @id @default(uuid())
  organizationId   String   @unique @map("organization_id")
  maxMonthlyCost   Float    @default(100.0) @map("max_monthly_cost")
  allowedProviders Json?    @map("allowed_providers") // Array of provider names
  enforceLocal     Boolean  @default(false) @map("enforce_local")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("workspace_ai_policies")
}

model LlmCache {
  id        String    @id @default(uuid())
  cacheKey  String    @unique @map("cache_key") // Hash of prompt+params
  cacheType String    @map("cache_type") // PROMPT, COMPLETION, EMBEDDING
  response  Json
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([cacheType, cacheKey])
  @@map("llm_cache")
}

// =========================================================
// 12. PROMPT ENGINEERING ENGINE (MODULE 012)
// =========================================================

model PromptEntity {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  name            String   @unique
  description     String?  @db.Text
  categoryId      String?  @map("category_id")
  ownerId         String?  @map("owner_id")
  status          String   @default("DRAFT") // DRAFT, REVIEW, APPROVED, PUBLISHED, DEPRECATED
  activeVersionId String?  @map("active_version_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     PromptCategory?    @relation(fields: [categoryId], references: [id])
  versions     PromptVersion[]
  analytics    PromptAnalytics[]
  deployments  PromptDeployment[]

  @@index([organizationId])
  @@index([categoryId])
  @@map("prompts")
}

model PromptCategory {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  prompts      PromptEntity[]

  @@unique([organizationId, name])
  @@map("prompt_categories")
}

model PromptVersion {
  id              String   @id @default(uuid())
  promptId        String   @map("prompt_id")
  versionNumber   String   @map("version_number") // 1.0.0
  templateString  String   @map("template_string") @db.Text
  inputSchema     Json?    @map("input_schema")
  outputSchema    Json?    @map("output_schema")
  supportedModels Json?    @map("supported_models")
  changeMessage   String?  @map("change_message") @db.Text
  status          String   @default("DRAFT")
  createdAt       DateTime @default(now()) @map("created_at")

  prompt      PromptEntity       @relation(fields: [promptId], references: [id], onDelete: Cascade)
  approvals   PromptApproval[]
  testResults PromptTestResult[]

  @@unique([promptId, versionNumber])
  @@map("prompt_versions")
}

model PromptApproval {
  id         String   @id @default(uuid())
  versionId  String   @map("version_id")
  reviewerId String   @map("reviewer_id")
  status     String // APPROVED, REJECTED
  comments   String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  version PromptVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
  @@map("prompt_approvals")
}

model PromptTestResult {
  id           String   @id @default(uuid())
  versionId    String   @map("version_id")
  modelId      String   @map("model_id")
  inputParams  Json     @map("input_params")
  outputResult Json     @map("output_result")
  qualityScore Float?   @map("quality_score")
  latencyMs    Int?     @map("latency_ms")
  cost         Float?
  createdAt    DateTime @default(now()) @map("created_at")

  version PromptVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
  @@map("prompt_test_results")
}

model PromptAnalytics {
  id             String   @id @default(uuid())
  promptId       String   @map("prompt_id")
  executionCount Int      @default(0) @map("execution_count")
  successRate    Float    @default(100.0) @map("success_rate")
  averageLatency Int      @default(0) @map("average_latency")
  averageCost    Float    @default(0.0) @map("average_cost")
  createdAt      DateTime @default(now()) @map("created_at")

  prompt PromptEntity @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@index([promptId])
  @@map("prompt_analytics")
}

model PromptDeployment {
  id          String   @id @default(uuid())
  promptId    String   @map("prompt_id")
  versionId   String   @map("version_id")
  environment String // PRODUCTION, STAGING
  deployedBy  String   @map("deployed_by")
  createdAt   DateTime @default(now()) @map("created_at")

  prompt PromptEntity @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@index([promptId])
  @@map("prompt_deployments")
}

// =========================================================
// 13. AI QUALITY ASSURANCE ENGINE (MODULE 013)
// =========================================================

model QualityReview {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  targetId        String   @map("target_id")
  targetType      String   @map("target_type") // E.g., AGENT_EXECUTION, BLOG_POST
  status          String   @default("PENDING_REVIEW") // DRAFT, PENDING_REVIEW, NEEDS_IMPROVEMENT, APPROVED, REJECTED
  overallScore    Float?   @map("overall_score")
  confidenceScore Float?   @map("confidence_score")
  reviewedBy      String?  @map("reviewed_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scores          QualityScoreRecord[]
  factValidations FactValidation[]
  hallucinations  HallucinationReport[]
  citationChecks  QualityCitationCheck[]
  grammar         GrammarReport[]
  readability     ReadabilityReport[]
  seo             SeoReport[]
  brand           BrandReport[]
  compliance      ComplianceReport[]
  safety          SafetyReport[]
  duplicates      DuplicateReport[]
  history         QualityHistory[]
  comments        QualityComment[]
  workflows       ApprovalWorkflow[]

  @@index([organizationId])
  @@index([targetType, targetId])
  @@map("quality_reviews")
}

model QualityScoreRecord {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  reviewId       String   @map("review_id")
  category       String // FACT, GRAMMAR, SEO, SAFETY, etc.
  score          Float
  weight         Float    @default(1.0)
  createdAt      DateTime @default(now()) @map("created_at")

