  @@index([accountId])
  @@map("integration_logs")
}

model IntegrationEvent {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  eventType      String   @map("event_type") // e.g., 'CONTENT_CREATED', 'LEAD_GENERATED'
