model CrmPipelineStage {
  id          String   @id @default(uuid())
  pipelineId  String   @map("pipeline_id")
  name        String
  orderIndex  Int      @map("order_index")
  probability Float    @default(0.0)
  createdAt   DateTime @default(now()) @map("created_at")

