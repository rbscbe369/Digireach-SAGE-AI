model BillingPlan {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique
  description     String?  @db.Text
  priceMonthly    Float    @default(0.0) @map("price_monthly")
  priceYearly     Float    @default(0.0) @map("price_yearly")
  currency        String   @default("USD")
  stripeProductId String?  @map("stripe_product_id")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")

  features      BillingFeature[]
  subscriptions BillingSubscription[]

  @@map("billing_plans")
}

model BillingFeature {
  id         String   @id @default(uuid())
  planId     String   @map("plan_id")
  featureKey String   @map("feature_key") // e.g., 'max_workspaces', 'ai_credits'
  limit      Int      @default(-1) // -1 for unlimited
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  plan BillingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, featureKey])
  @@map("billing_features")
}

model BillingSubscription {
  id                 String   @id @default(uuid())
  organizationId     String   @map("organization_id")
  planId             String   @map("plan_id")
  status             String   @default("TRIAL") // TRIAL, ACTIVE, PAST_DUE, CANCELLED
  interval           String   @default("MONTH") // MONTH, YEAR
  stripeSubId        String?  @map("stripe_sub_id")
  currentPeriodStart DateTime @map("current_period_start")
  currentPeriodEnd   DateTime @map("current_period_end")
  cancelAtPeriodEnd  Boolean  @default(false) @map("cancel_at_period_end")
  createdAt          DateTime @default(now()) @map("created_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         BillingPlan      @relation(fields: [planId], references: [id])
  invoices     BillingInvoice[]
  payments     BillingPayment[]
  credits      BillingCredit[]
  usage        BillingUsage[]

  @@index([organizationId])
  @@map("billing_subscriptions")
}

model BillingTenant {
  id             String   @id @default(uuid())
  organizationId String   @unique @map("organization_id")
  customDomain   String?  @map("custom_domain")
  brandingConfig Json?    @map("branding_config") // Logos, colors
  databaseType   String   @default("SHARED") // SHARED, DEDICATED
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("billing_tenants")
}

model BillingWorkspace {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  name           String
  quotaStorageMb Int      @default(1024) @map("quota_storage_mb")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("billing_workspaces")
}

model BillingInvoice {
  id             String   @id @default(uuid())
  subscriptionId String   @map("subscription_id")
  invoiceNumber  String   @map("invoice_number")
  amountDue      Float    @map("amount_due")
  amountPaid     Float    @default(0.0) @map("amount_paid")
  currency       String   @default("USD")
  status         String   @default("DRAFT") // DRAFT, OPEN, PAID, UNCOLLECTIBLE
  pdfUrl         String?  @map("pdf_url")
  createdAt      DateTime @default(now()) @map("created_at")

  subscription BillingSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  payments     BillingPayment[]

  @@index([subscriptionId])
  @@map("billing_invoices")
}

model BillingPayment {
  id             String   @id @default(uuid())
  invoiceId      String?  @map("invoice_id")
  subscriptionId String   @map("subscription_id")
  amount         Float
  currency       String   @default("USD")
  status         String   @default("SUCCEEDED") // PENDING, SUCCEEDED, FAILED
  paymentMethod  String   @map("payment_method") // CARD, PAYPAL
  stripeChargeId String?  @map("stripe_charge_id")
  createdAt      DateTime @default(now()) @map("created_at")

  invoice      BillingInvoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  subscription BillingSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  refunds      BillingRefund[]

  @@index([subscriptionId])
  @@map("billing_payments")
}

model BillingRefund {
  id        String   @id @default(uuid())
  paymentId String   @map("payment_id")
  amount    Float
  reason    String?
  status    String   @default("PENDING") // PENDING, SUCCEEDED, FAILED
  createdAt DateTime @default(now()) @map("created_at")

  payment BillingPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("billing_refunds")
}

model BillingCredit {
  id             String    @id @default(uuid())
  subscriptionId String    @map("subscription_id")
  amount         Int // Number of AI Credits
  balance        Int
  creditType     String    @map("credit_type") // MONTHLY, BONUS, PURCHASED
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  subscription BillingSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@map("billing_credits")
}

model BillingUsage {
  id             String   @id @default(uuid())
  subscriptionId String   @map("subscription_id")
  metric         String // AI_TOKENS, API_CALLS, STORAGE_MB
  quantity       Float
  recordedAt     DateTime @default(now()) @map("recorded_at")

  subscription BillingSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, metric, recordedAt])
  @@map("billing_usage")
}

model BillingCoupon {
  id             String    @id @default(uuid())
  code           String    @unique
  discountType   String    @map("discount_type") // PERCENTAGE, FIXED
  discountValue  Float     @map("discount_value")
  maxRedemptions Int?      @map("max_redemptions")
  timesRedeemed  Int       @default(0) @map("times_redeemed")
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("billing_coupons")
}

model BillingTax {
  id             String   @id @default(uuid())
  countryCode    String   @map("country_code")
  stateCode      String?  @map("state_code")
  taxType        String   @map("tax_type") // VAT, GST, SALES_TAX
  ratePercentage Float    @map("rate_percentage")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([countryCode, stateCode])
  @@map("billing_taxes")
}

model BillingLicense {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  licenseKey     String    @unique @map("license_key")
  licenseType    String    @map("license_type") // TEAM, ENTERPRISE, LIFETIME
  maxSeats       Int       @default(1) @map("max_seats")
  isActive       Boolean   @default(true) @map("is_active")
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  devices BillingDevice[]

  @@index([organizationId])
  @@map("billing_licenses")
}

model BillingDevice {
  id         String   @id @default(uuid())
  licenseId  String   @map("license_id")
  deviceId   String   @map("device_id")
  deviceName String?  @map("device_name")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")

