  voiceScore      Float    @default(0.0) @map("voice_score")
  semanticScore   Float    @default(0.0) @map("semantic_score")
  trustScore      Float    @default(0.0) @map("trust_score")
  updatedAt       DateTime @updatedAt @map("updated_at")

  project AiSearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

