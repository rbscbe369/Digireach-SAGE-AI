model SecurityUser {
  id            String    @id @default(uuid())
  userId        String    @unique @map("user_id") // Links to Better Auth User
  mfaEnabled    Boolean   @default(false) @map("mfa_enabled")
  mfaType       String?   @map("mfa_type") // TOTP, SMS, WEBAUTHN
  securityScore Float     @default(100.0) @map("security_score")
  status        String    @default("ACTIVE") // ACTIVE, SUSPENDED, LOCKED
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles SecurityRole[] @relation("UserRoles")

  @@map("security_users")
}

model SecurityRole {
  id             String   @id @default(uuid())
  organizationId String?  @map("organization_id") // Null for global platform roles
  name           String
  description    String?  @db.Text
  isCustom       Boolean  @default(true) @map("is_custom")
  createdAt      DateTime @default(now()) @map("created_at")

  permissions SecurityPermission[]
  users       SecurityUser[]       @relation("UserRoles")

  @@index([organizationId])
  @@map("security_roles")
}

model SecurityPermission {
  id         String   @id @default(uuid())
  roleId     String   @map("role_id")
  resource   String // e.g., 'blog', 'billing', 'crm_lead'
  action     String // CREATE, READ, UPDATE, DELETE, MANAGE
  conditions Json? // ABAC conditions
  createdAt  DateTime @default(now()) @map("created_at")

  role SecurityRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([roleId])
  @@map("security_permissions")
}

model SecurityPolicy {
  id             String   @id @default(uuid())
  organizationId String?  @map("organization_id")
  name           String
  policyType     String   @map("policy_type") // PASSWORD, MFA, SESSION, IP_RESTRICTION
  rules          Json // Configuration of the policy
  enforcement    String   @default("BLOCK") // BLOCK, WARN, AUDIT
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId])
  @@map("security_policies")
}

model SecuritySession {
  id             String   @id @default(uuid())
  sessionId      String   @unique @map("session_id") // Links to Better Auth Session
  userId         String   @map("user_id")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  location       String?
  deviceType     String?  @map("device_type")
  riskScore      Float    @default(0.0) @map("risk_score")
  status         String   @default("ACTIVE") // ACTIVE, REVOKED, EXPIRED
  lastActivityAt DateTime @default(now()) @map("last_activity_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("security_sessions")
}

model SecurityDevice {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  fingerprint String   @unique
  os          String?
  browser     String?
  trustLevel  String   @default("UNKNOWN") // TRUSTED, UNKNOWN, BLOCKED
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("security_devices")
}

model SecurityAuditLog {
  id             String   @id @default(uuid())
  organizationId String?  @map("organization_id")
  userId         String?  @map("user_id")
  action         String // LOGIN_FAILED, ROLE_UPDATED, DATA_EXPORTED
  resource       String? // User, Role, Billing
  resourceId     String?  @map("resource_id")
  ipAddress      String?  @map("ip_address")
  metadata       Json?
  status         String   @default("SUCCESS") // SUCCESS, FAILURE
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, action])
  @@index([userId])
  @@map("security_audit_logs")
}

model SecurityIncident {
  id             String    @id @default(uuid())
  organizationId String?   @map("organization_id")
  severity       String    @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL
  type           String // BRUTE_FORCE, SUSPICIOUS_LOGIN, DATA_EXFILTRATION
  description    String    @db.Text
  status         String    @default("OPEN") // OPEN, INVESTIGATING, RESOLVED, FALSE_POSITIVE
  resolvedAt     DateTime? @map("resolved_at")
  metadata       Json?
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([organizationId, status])
  @@map("security_incidents")
}

model SecurityRiskScore {
  id           String   @id @default(uuid())
  targetId     String   @map("target_id") // userId or organizationId
  targetType   String   @map("target_type") // USER, ORGANIZATION
  score        Float // 0-100
  factors      Json // Reasons for the score
  calculatedAt DateTime @default(now()) @map("calculated_at")

  @@index([targetId, targetType])
  @@map("security_risk_scores")
}

model SecuritySecret {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  name           String
  encryptedValue String    @map("encrypted_value") @db.Text
  version        Int       @default(1)
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([organizationId])
  @@map("security_secrets")
